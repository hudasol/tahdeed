{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tahdeed/human-kit/response.schema.json",
  "title": "Tahdeed human benchmark: volunteer response file",
  "description": "One file per volunteer, produced by form/index.html. Contains free-text route descriptions for public places only. No name, email, phone or IP is collected.",
  "type": "object",
  "required": ["schema_version", "kit", "volunteer_code", "consent", "responses"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "kit": { "const": "tahdeed-human-kit" },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date only (UTC), no time of day."
    },
    "volunteer_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,32}$",
      "description": "Code given by the organiser. It is replaced by a salted hash at ingest."
    },
    "consent": {
      "type": "object",
      "required": ["agreed", "version"],
      "additionalProperties": false,
      "properties": {
        "agreed": { "const": true },
        "version": { "type": "string", "maxLength": 32 }
      }
    },
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional, coarse buckets only.",
      "properties": {
        "emirate_residence": {
          "enum": [
            "abu_dhabi",
            "dubai",
            "sharjah",
            "ajman",
            "umm_al_quwain",
            "ras_al_khaimah",
            "fujairah",
            "outside_uae",
            "prefer_not_to_say",
            ""
          ]
        },
        "years_in_uae": {
          "enum": ["lt1", "1-5", "6-10", "gt10", "born_here", "prefer_not_to_say", ""]
        }
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["place_id"],
        "additionalProperties": false,
        "properties": {
          "place_id": { "type": "string", "pattern": "^P\\d{3}$" },
          "text": { "type": "string", "maxLength": 600 },
          "script_self": {
            "enum": ["ar", "en", "arabizi", "mixed", ""],
            "description": "Optional self-label of how the volunteer wrote."
          },
          "skipped": { "type": "boolean" },
          "pii_warning_acknowledged": { "type": "boolean" }
        }
      }
    }
  }
}
